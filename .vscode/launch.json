{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "DroneInventory API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build-api",
            "program": "${workspaceFolder}/backend/DroneInventory.Api/bin/Debug/net10.0/DroneInventory.Api.dll",
            "cwd": "${workspaceFolder}/backend/DroneInventory.Api",
            "console": "integratedTerminal",
            "stopAtEntry": false,
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5087"
            }
        }
    ]
}
