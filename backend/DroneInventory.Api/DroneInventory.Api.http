@DroneInventory.Api_HostAddress = http://localhost:5087

### List drones (REQ-002) → 200
GET {{DroneInventory.Api_HostAddress}}/api/drones
Accept: application/json

### Create a drone (REQ-001) → 201
POST {{DroneInventory.Api_HostAddress}}/api/drones
Content-Type: application/json

{
  "name": "TELLO-07",
  "description": "SSID: TELLO-9FA21B, rechter Propellerschutz beschädigt"
}

### Duplicate name, other case (REQ-001) → 409
POST {{DroneInventory.Api_HostAddress}}/api/drones
Content-Type: application/json

{
  "name": "tello-07"
}

### Empty name (REQ-001) → 422
POST {{DroneInventory.Api_HostAddress}}/api/drones
Content-Type: application/json

{
  "name": "   "
}

###

### List student groups (REQ-003) → 200
GET {{DroneInventory.Api_HostAddress}}/api/student-groups
Accept: application/json

### Create a student group (REQ-003) → 201
POST {{DroneInventory.Api_HostAddress}}/api/student-groups
Content-Type: application/json

{
  "name": "Group 3"
}

### Duplicate group name (REQ-003) → 409
POST {{DroneInventory.Api_HostAddress}}/api/student-groups
Content-Type: application/json

{
  "name": " group 3 "
}

###

### Loan a drone with accessories (REQ-004, REQ-006) → 201
POST {{DroneInventory.Api_HostAddress}}/api/loans
Content-Type: application/json

{
  "droneId": 1,
  "studentGroupId": 1,
  "batteries": 4,
  "propellers": 8
}

### Negative quantity (REQ-006) → 422
POST {{DroneInventory.Api_HostAddress}}/api/loans
Content-Type: application/json

{
  "droneId": 1,
  "studentGroupId": 1,
  "batteries": -1
}

###
